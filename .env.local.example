# ===== 推送渠道（二选一即可，推荐 PushPlus）=====
# PushPlus（推荐，简单）：https://www.pushplus.plus 用微信扫码登录 →
# 首页复制你的 token（一长串字符）填入下面，并在微信关注 PushPlus 公众号即可收到消息
PUSHPLUS_TOKEN=

# 企业微信（可选，无条数限制但需注册企业微信）：
# 我的企业 → 企业ID = WECOM_CORPID；应用管理→自建应用 → Secret / AgentId
#WECOM_CORPID=
#WECOM_SECRET=
#WECOM_AGENT_ID=
#WECOM_TOUSER=@all

# ===== 雪球 / 微博 Cookie（用 scripts/refresh_cookies.py 获取）=====
XUEQIU_COOKIE=
WEIBO_COOKIE=
